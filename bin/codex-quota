#!/usr/bin/env bash
# codex-quota 启动器：脱离终端后台运行，终端关闭不影响。
# 日志：~/.cache/codex-quota/hud.log
set -euo pipefail

# readlink -f 解析软链：本脚本可能被软链到 ~/.local/bin（install.sh 第 6 步），
# 直接用 BASH_SOURCE 会把 ~/.local 当成项目根 → 找不到 .venv → 静默起不来
ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
PY="$ROOT/.venv/bin/python"
[ -x "$PY" ] || PY=python3

# 无 root 时 vendor/ 里的 libxcb-cursor 兜底（系统已装则无需）
if [ -d "$ROOT/vendor/lib" ]; then
    export LD_LIBRARY_PATH="$ROOT/vendor/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
fi

LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/codex-quota"
mkdir -p "$LOG_DIR"

# stop / restart：应用卡死（僵尸实例不响应）时的逃生门——优雅 SIGTERM，
# 超时强杀，并清掉单实例 socket/锁残留
if [ "${1:-}" = "stop" ] || [ "${1:-}" = "restart" ]; then
    if pgrep -f "[b]in/python.*-m codex_quota" >/dev/null 2>&1; then
        echo "正在停止 codex-quota..."
        pkill -f "[b]in/python.*-m codex_quota" || true
        for _ in $(seq 1 45); do  # 优雅退出需回收子进程（隧道/服务器），最多等 45s
            pgrep -f "[b]in/python.*-m codex_quota" >/dev/null 2>&1 || break
            sleep 1
        done
        if pgrep -f "[b]in/python.*-m codex_quota" >/dev/null 2>&1; then
            pkill -9 -f "[b]in/python.*-m codex_quota" || true
            sleep 1
        fi
        rm -f "/tmp/codex-quota-$(id -u)" "$LOG_DIR/codex-quota-$(id -u).lock"
        echo "已停止"
    else
        echo "codex-quota 未在运行"
    fi
    [ "${1:-}" = "stop" ] && exit 0
    echo "正在重启..."
fi

if pgrep -f "[b]in/python.*-m codex_quota" >/dev/null 2>&1; then
    echo "codex-quota 已在运行"
    exit 0
fi

setsid "$PY" -m codex_quota "$@" >>"$LOG_DIR/hud.log" 2>&1 < /dev/null &
disown
# 启动后等 3 秒确认进程真的活着：之前 spawn 完就打印"已启动"，
# 进程秒退（依赖缺失/启动崩溃）时用户被误导，只能去翻日志才发现
sleep 3
if pgrep -f "[b]in/python.*-m codex_quota" >/dev/null 2>&1; then
    echo "codex-quota 已启动（日志: $LOG_DIR/hud.log）"
else
    echo "codex-quota 启动失败，日志末尾：" >&2
    tail -n 15 "$LOG_DIR/hud.log" >&2
    exit 1
fi
